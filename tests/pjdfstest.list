# pjdfstest subset (DESIGN.md §15.1), run by tests/pjdfstest.sh over the fake backend.
# commit: 85a8aea9e685999ef0540392fd80535f873d7ff7 (https://github.com/pjd/pjdfstest)
#
# Directories in the subset: open, rename, unlink, mkdir, rmdir, truncate, ftruncate, chmod, utimensat.
# link, symlink, mknod and mkfifo are left out: they give EPERM by design (§8.7), checked by scenario N1.
# The file-type loops run over regular files and directories only (tests/pjdfstest.sh).
#
# One line per test file with failures: <file> <failing test numbers | skip> <reason>.
# Files not listed must pass completely. Reasons:
#   root       needs other users: `-u`/`-g` credential switches and chown to other ids. The agent is not
#              root, and without `user_allow_other` only the mounting user can use the mount (D020).
#              Includes what follows from it (files the next steps expect are missing or still there).
#   types      creates a symlink, hard link, fifo, socket or device node, which the mount refuses with
#              EPERM (§8.7), and what follows from it.
#   dir-nlink  directories report nlink 1 ("unknown", as on btrfs), not 2 + subdirectories.
#   quota      truncate(999999999999999) gives ENOSPC from the quota check (§7.8); the test accepts
#              only success, EFBIG or EINVAL.
#
chmod/00.t       5-8,10,15-18,20,31,35,39-42,44           root,types
chmod/04.t       4,6                                      types
chmod/05.t       3-6,8,10-12                              root
chmod/06.t       1-8                                      types
chmod/07.t       3-23                                     root
chmod/11.t       5-8,13-16,19-25,29-35                    root,types
chmod/12.t       3-4,7-8,11-12                            root
